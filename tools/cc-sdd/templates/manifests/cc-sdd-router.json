{
  "version": 1,
  "artifacts": [
    {
      "id": "doc_main",
      "source": {
        "type": "templateFile",
        "from": "templates/agents/claude-code-skills/docs/CLAUDE.md",
        "toDir": ".",
        "rename": "ROUTER.md"
      },
      "when": { "agent": "cc-sdd-router" }
    },
    {
      "id": "settings_templates",
      "source": {
        "type": "templateDir",
        "fromDir": "templates/shared/settings/templates",
        "toDir": "{{KIRO_DIR}}/settings/templates"
      },
      "when": { "agent": "cc-sdd-router" }
    }
  ]
}
